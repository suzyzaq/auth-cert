# 业务接口 Bearer Token（必填，未配置时业务接口 fail-closed）
BRAND_API_TOKEN=change-me-to-a-strong-token

# 品牌主库路径（默认自动发现 brand-matcher Skill 的 matcher.db）
BRAND_DATA_PATH=C:/Users/Lenovo/.workbuddy/skills/brand-matcher/data/matcher.db

# 预留：独立别名库路径（当前正式别名在 matcher.db 的 brand_alias 表内，留空即可）
BRAND_ALIAS_DATA_PATH=

HOST=0.0.0.0
PORT=8000
# 宿主机映射端口；容器内始终为 8000
BRAND_HOST_PORT=8000

# ---- SCS 在线品牌库回退（本地未命中时查询，仅启用状态品牌，只作候选） ----
# 1=开启（默认）  0=关闭
SCS_ENABLED=1
# Token 文件（JSON: {"Authorization":"Bearer <JWT>","X-XSRF-TOKEN":"<token>"}）
# 由 scripts/refresh_scs_token.py 每周刷新，服务按文件 mtime 自动热加载
SCS_TOKEN_FILE=C:/Users/Lenovo/.workbuddy/secrets/scs-token.json
SCS_ENDPOINT=https://scs.officemate.cn/scs-purchase-api/brand/getBrandSapList
SCS_TIMEOUT=5
SCS_CACHE_TTL=3600
